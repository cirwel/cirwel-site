---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import Plate from '../components/Plate.astro';
import Tailpiece from '../components/Tailpiece.astro';

// The install command is the server README's, verbatim: it pins the latest
// verified release tag. Held as a string so it is diffable and so
// src/data/claims.json can pin it against the README.
const install = 'v=$(curl -fsSL https://raw.githubusercontent.com/cirwel/unitares/master/PUBLISHED_VERSION) && git clone --branch "v$v" --depth 1 https://github.com/cirwel/unitares.git && cd unitares && docker compose up -d --wait';
const homebrew = `brew update
brew tap cirwel/unitares
brew trust cirwel/unitares
brew install cirwel/unitares/unitares
brew pin unitares unitares-lease-plane`;

// One real record from the deployment, shown as the home page's figure plate
// (EDITORIAL.md §6). The section renders only when src/data/example-record.json
// exists, so the page never shows an invented example. Shape:
// { "caption": "...", "source_url": "https://...",
//   "entries": [{ "kind": "Claim" | "Challenge" | "Outcome", "who": "...", "text": "..." }] }
const exampleModules = import.meta.glob('../data/example-record.json', { eager: true, import: 'default' });
const example = Object.values(exampleModules)[0] as
  | { caption: string; source_url: string; entries: { kind: string; who: string; text: string }[] }
  | undefined;
---
<BaseLayout
  title="UNITARES: Accountability infrastructure for long-running AI agents — CIRWEL Research"
  description="Many agents, one record. UNITARES is self-hosted accountability infrastructure for operators running multiple AI agents: independent runtimes share one operator-controlled record of who did what, what evidence backed it, who reviewed it, and what happened next."
>
  <PageHeader currentPath="/" />

  <main class="px-6 lg:px-12 max-w-screen-xl mx-auto">

    <!-- HERO: what it is, why it matters, two ways in. Plain words for a first-time
         reader (EDITORIAL.md §1); the canonical definition sits under "In precise terms". -->
    <section class="pt-16 pb-12 lg:pt-28 lg:pb-16">
      <p class="label text-oxblood mb-8 reveal reveal-1">UNITARES</p>
      <h1 class="display text-5xl md:text-7xl lg:text-8xl !leading-[1.14] mb-10 reveal reveal-2">
        Many agents,<br/>
        one record.
      </h1>
      <p class="text-xl md:text-2xl leading-relaxed text-ink max-w-prose reveal reveal-3">
        Your AI agents share one record of what they did, what they claimed, who challenged it, and how it turned out.
      </p>
      <p class="text-lg md:text-xl leading-relaxed text-stone max-w-prose reveal reveal-3 mt-4">
        Logs show each run. The record keeps the thread between them, so whoever picks up next can find where the last one left off.
      </p>
      <nav aria-label="Ways into UNITARES" class="mt-10 flex flex-wrap items-baseline gap-x-8 gap-y-4 reveal reveal-4">
        <a href="#install" class="cta">Install</a>
        <a href="https://github.com/cirwel/unitares" class="label text-oxblood no-underline hover:underline">Source on GitHub</a>
      </nav>
    </section>

    <!-- RECEIPTS: facts a stranger can check without reading further. -->
    <section class="py-8 border-t border-b border-sepia reveal reveal-5" aria-label="The receipts">
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-6 text-base">
        <div><dt class="label text-stone mb-1">Open source</dt><dd><a href="https://github.com/cirwel/unitares">Apache 2.0</a></dd></div>
        <div><dt class="label text-stone mb-1">Self-hosted</dt><dd>on your own infrastructure</dd></div>
        <div><dt class="label text-stone mb-1">Works with</dt><dd>Claude Code, Codex, Hermes Agent, any MCP client</dd></div>
        <div><dt class="label text-stone mb-1">In use</dt><dd>since November 2025 <span class="text-stone">· CIRWEL's long-running development environment</span></dd></div>
      </dl>
    </section>

    {example && (
      <!-- EXAMPLE: one real record, claim to outcome. -->
      <section id="example" class="py-16 lg:py-20">
        <h2 class="display text-3xl md:text-5xl mb-8 leading-tight">One record, start to finish</h2>
        <div class="max-w-prose">
          <Plate>
            <ol class="space-y-6">
              {example.entries.map((e) => (
                <li>
                  <p class="label text-oxblood mb-1">{e.kind} · <span class="text-stone">{e.who}</span></p>
                  <p class="text-base leading-relaxed">{e.text}</p>
                </li>
              ))}
            </ol>
          </Plate>
          <p class="text-sm text-stone mt-4">{example.caption} <a href={example.source_url}>See the original.</a></p>
        </div>
      </section>
    )}

    <!-- WHAT IT ANSWERS: the five questions (EDITORIAL.md §2), one plain line each;
         the links carry the mechanism. -->
    <section id="what" class="py-16 lg:py-20">
      <h2 class="display text-3xl md:text-5xl mb-6 leading-tight">What the record answers</h2>
      <p class="text-lg leading-relaxed text-stone max-w-prose mb-10">
        A coding session restarts. An agent loses its context. A task moves to another process. Logs show each run, but not the thread that connects them.
      </p>
      <div class="register" role="list" aria-label="What the record answers">
        <div class="reg-col" role="listitem">
          <h3 class="reg-q">Who said it?</h3>
          <p class="reg-body">Each write is tied to the process that made it.</p>
          <a href="/ecosystem#identity" class="reg-link">Identity &amp; lineage</a>
        </div>
        <div class="reg-col" role="listitem">
          <h3 class="reg-q">What supports it?</h3>
          <p class="reg-body">Findings and corrections are kept, with their sources.</p>
          <a href="/ecosystem#knowledge" class="reg-link">Shared memory</a>
        </div>
        <div class="reg-col" role="listitem">
          <h3 class="reg-q">Who challenged it?</h3>
          <p class="reg-body">Reviews and disagreements stay on the record.</p>
          <a href="/ecosystem#verdicts" class="reg-link">Policy &amp; review</a>
        </div>
        <div class="reg-col" role="listitem">
          <h3 class="reg-q">What happened?</h3>
          <p class="reg-body">Test results are recorded against the check-in that predicted them.</p>
          <a href="/build#loop" class="reg-link">The loop</a>
        </div>
        <div class="reg-col" role="listitem">
          <h3 class="reg-q">What can a successor recover?</h3>
          <p class="reg-body">Findings, reviews, and outcomes, by search.</p>
          <a href="/ecosystem#layers" class="reg-link">Architecture</a>
        </div>
      </div>
      <p class="text-lg leading-relaxed text-stone max-w-prose mt-10">
        It runs beside evals, guardrails, and sandboxes and replaces none of them.
      </p>
    </section>

    <!-- INSTALL -->
    <section id="install" class="py-12">
      <h2 class="display text-3xl md:text-4xl mb-6 leading-tight">Install</h2>
      <h3 class="display text-2xl mb-4">Apple Silicon Mac · Homebrew preview</h3>
      <div class="max-w-prose"><pre class="codeplate">{homebrew}</pre></div>
      <p class="text-base text-stone mt-4 mb-8 max-w-prose">
        Installs the native server and its dependencies. Then follow the <a href="https://github.com/cirwel/homebrew-unitares#first-time-setup">database setup and startup steps</a>. Models, including Ollama, are optional.
      </p>
      <h3 class="display text-2xl mb-4">Docker Compose</h3>
      <div class="runcmd max-w-prose"><span class="prompt">$</span><span class="cmd">{install}</span></div>
      <p class="text-base text-stone mt-4 max-w-prose">
        Starts the server and its databases locally with Docker. Choose one installation per machine. <a href="/build#run">Setup and installation options</a> · <a href="/ecosystem">How it fits together</a> · <a href="/research">Research</a> · <a href="mailto:founder@cirwel.org">founder@cirwel.org</a>
      </p>
    </section>

    <!-- IN PRECISE TERMS: the README's three definition sentences, verbatim
         (EDITORIAL.md §1); "federation" and "kernel" are defined in the sentence that uses them. -->
    <section class="pt-10 pb-6 border-t border-sepia">
      <p class="label text-stone mb-3">In precise terms</p>
      <p class="text-sm leading-relaxed text-stone max-w-prose">
        UNITARES is self-hosted accountability infrastructure for operators running multiple AI agents. The UNITARES single-operator federation kernel connects independent runtimes to one operator-controlled server over MCP or HTTP, where they share a durable record while keeping their own models, tools, and runtimes. They interoperate with each other over their own transports or A2A; UNITARES is the record behind them, not the transport between them.
      </p>
      <p class="text-sm text-stone mt-3">
        By <span class="smcp">Kenny Wang</span>, Independent Researcher · ORCID <a href="https://orcid.org/0009-0006-7544-2374" class="font-mono">0009-0006-7544-2374</a> · <a href="https://doi.org/10.5281/zenodo.19647159">Paper</a>
      </p>
    </section>

    <div class="flex justify-center pt-10 pb-2">
      <Tailpiece class="opacity-90" />
    </div>

  </main>

  <PageFooter publishersMark />
</BaseLayout>
