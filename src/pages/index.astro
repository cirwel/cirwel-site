---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PageFooter from '../components/PageFooter.astro';
import SectionRule from '../components/SectionRule.astro';
import Seal from '../components/Seal.astro';
import Plate from '../components/Plate.astro';
import Tailpiece from '../components/Tailpiece.astro';
import liveStats from '../data/live-stats.json';
import frontispieceSvg from '../../public/sketches/frontispiece.svg?raw';

const fmtStat = (v: string) => (/^\d+$/.test(v) ? Number(v).toLocaleString('en-US') : v);

// The install command is the server README's, verbatim: it pins the latest
// verified release tag. Held as a string so it is diffable and so
// src/data/claims.json can pin it against the README.
const install = 'v=$(curl -fsSL https://raw.githubusercontent.com/cirwel/unitares/master/PUBLISHED_VERSION) && git clone --branch "v$v" --depth 1 https://github.com/cirwel/unitares.git && cd unitares && docker compose up -d --wait';
---
<BaseLayout
  title="UNITARES: Accountability infrastructure for long-running AI agents — CIRWEL Research"
  description="Many agents, one record. UNITARES is self-hosted accountability infrastructure for operators running multiple AI agents: independent runtimes share one operator-controlled record of who did what, what evidence backed it, who reviewed it, and what happened next."
>
  <PageHeader currentPath="/" />

  <main class="px-6 lg:px-12 max-w-screen-xl mx-auto">

    <!-- HERO -->
    <section class="pt-16 pb-16 lg:pt-28 lg:pb-20 grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-9">
        <p class="label text-oxblood mb-8 reveal reveal-1">UNITARES, from CIRWEL Research</p>
        <h1 class="display text-5xl md:text-7xl lg:text-8xl !leading-[1.14] mb-10 reveal reveal-2">
          Many agents,<br/>
          one record.
        </h1>
        <!-- The three definition sentences are the README's, verbatim (EDITORIAL.md §1).
             The first is the subhead and the third follows it. The second, which names
             the federation kernel, sits under the figure on its own, with its opening
             pronoun resolved to the product name. -->
        <p class="text-lg md:text-xl leading-relaxed text-ink max-w-prose reveal reveal-3">
          <span class="font-medium">UNITARES is self-hosted accountability infrastructure for operators running multiple AI agents.</span>
        </p>
        <p class="text-base md:text-lg leading-relaxed text-stone max-w-prose reveal reveal-3 mt-6">
          The goal is simple: agent work should remain attributable, reviewable, and recoverable even when the process that started it is gone.
        </p>
        <nav aria-label="Ways into UNITARES"
             class="mt-10 pt-6 border-t border-sepia flex flex-wrap items-baseline gap-x-8 gap-y-4 reveal reveal-4">
          <a href="/build" class="cta">Run UNITARES</a>
          <a href="/ecosystem" class="label text-oxblood no-underline hover:underline">How it fits together</a>
          <a href="/research" class="label text-oxblood no-underline hover:underline">The research record</a>
        </nav>

        <figure class="mt-14 max-w-3xl figure-svg reveal reveal-5" role="img"
                aria-label="Five kinds of agent around one shared record: many agents, one record.">
          <Fragment set:html={frontispieceSvg} />
        </figure>
        <p class="text-base leading-relaxed text-stone max-w-prose mt-6 reveal reveal-5">
          The UNITARES federation kernel connects independent runtimes to one operator-controlled server over MCP or HTTP, where they share a durable record while keeping their own models, tools, and runtimes.
        </p>
      </div>
    </section>

    <hr class="hairline mb-2"/>

    <!-- RECEIPTS -->
    <section class="py-10 grid grid-cols-12 gap-6 reveal reveal-5">
      <div class="col-span-12 lg:col-span-3 mb-4 lg:mb-0">
        <p class="label text-oxblood">The receipts</p>
      </div>
      <dl class="col-span-12 lg:col-span-9 grid grid-cols-12 gap-y-5 gap-x-6">
        <dt class="col-span-4 md:col-span-3 label text-stone pt-1">Software</dt>
        <dd class="col-span-8 md:col-span-9">
          <a href="https://github.com/cirwel/unitares" class="font-medium">UNITARES</a>
          <span class="text-stone"> · Apache 2.0 · server + SDK + agent interfaces</span>
        </dd>

        <dt class="col-span-4 md:col-span-3 label text-stone pt-1">Paper</dt>
        <dd class="col-span-8 md:col-span-9">
          <a href="https://doi.org/10.5281/zenodo.19647159" class="font-medium">UNITARES: Information-Theoretic Governance of Heterogeneous Agent Fleets</a>
          <span class="text-stone"> · Wang, 2026 · CC-BY 4.0</span>
        </dd>

        <dt class="col-span-4 md:col-span-3 label text-stone pt-1">In use</dt>
        <dd class="col-span-8 md:col-span-9">
          Running continuously <span class="font-medium">since November 2025</span>
          <span class="text-stone"> · CIRWEL's long-running development environment</span>
        </dd>

        <dt class="col-span-4 md:col-span-3 label text-stone pt-1">For</dt>
        <dd class="col-span-8 md:col-span-9 text-stone">
          operators running several long-lived AI agents on infrastructure they control
        </dd>

        <dt class="col-span-4 md:col-span-3 label text-stone pt-1">Author</dt>
        <dd class="col-span-8 md:col-span-9">
          <span class="smcp">Kenny Wang</span> <span class="text-stone">· Independent Researcher · ORCID</span>
          <a href="https://orcid.org/0009-0006-7544-2374" class="font-mono text-sm">0009-0006-7544-2374</a>
        </dd>
      </dl>
    </section>

    <SectionRule class="mt-2 mb-12" />

    <!-- §01 WHAT IT KEEPS -->
    <section id="what" class="py-16 lg:py-24 grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-3 mb-6 lg:mb-0">
        <p class="section-mark"><span class="sm-num">§&#8201;I</span><span class="sm-name">What the record answers</span></p>
      </div>
      <div class="col-span-12 lg:col-span-9">
        <h2 class="display text-3xl md:text-5xl mb-8 leading-tight max-w-prose">
          Five questions, one mechanism each.
        </h2>
        <p class="text-lg leading-relaxed text-stone max-w-prose mb-10">
          A coding session restarts. A research agent loses its context. A task moves to another process, and the evidence arrives after the process that made the claim is gone. Logs show each run; they do not keep these five answers connected across the boundary.
        </p>


      </div>
      <!-- The five questions as a ruled register: one column per question the
           record answers, read across like the head of a ledger page. -->
      <div class="col-span-12 register mt-4" role="list" aria-label="What the record answers">
          <div class="reg-col" role="listitem">
            <h3 class="reg-q">Who said it?</h3>
            <p class="reg-body">Every write is bound to a fresh process identity. Lineage records which earlier process this one inherited work from; it does not make two processes one identity.</p>
            <a href="/ecosystem#identity" class="reg-link">Identity &amp; lineage</a>
          </div>
          <div class="reg-col" role="listitem">
            <h3 class="reg-q">What supports it?</h3>
            <p class="reg-body">Check-ins carry the state the server derived from them, and findings, corrections, and their provenance are kept as durable records that outlive the process that wrote them.</p>
            <a href="/ecosystem#knowledge" class="reg-link">Shared memory</a>
          </div>
          <div class="reg-col" role="listitem">
            <h3 class="reg-q">Who challenged it?</h3>
            <p class="reg-body">Structured review keeps the disagreement, the conditions, and the resolution as part of the record, and a reviewer's objection binds on the agent it was raised against.</p>
            <a href="/ecosystem#verdicts" class="reg-link">Policy &amp; review</a>
          </div>
          <div class="reg-col" role="listitem">
            <h3 class="reg-q">What happened?</h3>
            <p class="reg-body">Outcomes such as test results and exit codes are recorded against the check-in that predicted them. The gap between the claim and the outcome is the calibration signal.</p>
            <a href="/build#loop" class="reg-link">The loop</a>
          </div>
          <div class="reg-col" role="listitem">
            <h3 class="reg-q">What can a successor recover?</h3>
            <p class="reg-body">Shared-memory search, review records, and history export give a later process what it needs to understand the work and continue it.</p>
            <a href="/ecosystem#layers" class="reg-link">Architecture</a>
          </div>
      </div>
      <div class="col-span-12 lg:col-start-4 lg:col-span-9">
        <p class="text-lg leading-relaxed text-stone max-w-prose mt-4">
          Claude Code, Codex, and custom runtimes keep their own models and tools. UNITARES keeps the record. It runs beside evals, guardrails, and sandboxes and replaces none of them.
        </p>
      </div>
    </section>

    <SectionRule />

    <!-- §02 IN USE -->
    <section id="production" class="py-16 lg:py-24 grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-3 mb-6 lg:mb-0">
        <p class="section-mark"><span class="sm-num">§&#8201;II</span><span class="sm-name">In use</span></p>
        <Seal class="hidden lg:block mt-10" />
      </div>
      <div class="col-span-12 lg:col-span-9">
        <h2 class="display text-3xl md:text-5xl mb-8 leading-tight max-w-prose">UNITARES keeps its own development record.</h2>
        <div class="space-y-6 text-lg leading-relaxed text-stone max-w-prose mb-10">
          <p class="dropcap">
            The agents building UNITARES check in to it, write what they learn to its shared memory, and send their changes through its structured review. One case from that record:
          </p>
        </div>

        <!-- One real, verified episode rather than a description of the loop.
             Every statement is checkable against the public PR's own "Review
             provenance" section and commit list; claims.json pins it. -->
        <dl class="case-record max-w-prose mb-12" aria-label="A reviewed change, 22 August 2026">
          <div><dt>Proposed</dt><dd>An agent's patch let an automatic pause on a newly started agent relax to guidance whenever the pause was labelled a risk stop.</dd></div>
          <div><dt>Challenged</dt><dd>A structured review rejected it. The label names only the first stop the code reached, so it cannot show that no other hard stop fired at the same moment.</dd></div>
          <div><dt>Changed</dt><dd>The fix was rebuilt to relax a pause only when the complete decision-time record proves risk was the sole stop, and to keep the pause for anything missing or contradictory. A second review accepted it with five conditions, and it merged the same day.</dd></div>
          <p class="case-source">22 August 2026 · the first patch, both reviews, and the rebuild are recorded in <a href="https://github.com/cirwel/unitares/pull/1819">cirwel/unitares#1819</a></p>
        </dl>

        <div class="max-w-prose">
        <Plate>
          <dl class="grid grid-cols-2 gap-y-8 gap-x-8">
            <div>
              <dt class="label text-stone mb-2">Recorded events</dt>
              <dd class="display text-3xl md:text-4xl !leading-[1.14]">{fmtStat(liveStats.events_total)}</dd>
            </div>
            <div>
              <dt class="label text-stone mb-2">Shared findings</dt>
              <dd class="display text-3xl md:text-4xl !leading-[1.14]">{fmtStat(liveStats.kg_discoveries)}</dd>
            </div>
          </dl>
        </Plate>
        </div>
        <p class="text-sm text-stone mt-6 max-w-prose">
          Measured {liveStats.refreshed_at}. These are records from CIRWEL's own development environment. They show the mechanisms exercised under real use, not external adoption or improved outcomes.
        </p>

      </div>
    </section>

    <SectionRule />

    <!-- §03 START HERE -->
    <section id="contact" class="py-16 lg:py-24 grid grid-cols-12 gap-6">
      <div class="col-span-12 lg:col-span-3 mb-6 lg:mb-0">
        <p class="section-mark"><span class="sm-num">§&#8201;III</span><span class="sm-name">Start here</span></p>
      </div>
      <div class="col-span-12 lg:col-span-9">
        <h2 class="display text-3xl md:text-5xl mb-10 leading-tight">Run it, read it, or inspect the evidence.</h2>
        <ul class="space-y-7 text-lg max-w-prose">
          <li class="grid grid-cols-12 gap-4 items-start">
            <span class="col-span-12 md:col-span-2 label text-stone pt-1">Run</span>
            <div class="col-span-12 md:col-span-10 space-y-3">
              <p><a href="https://github.com/cirwel/unitares" class="font-medium">UNITARES</a> boots locally with Docker Compose and exposes MCP, REST, an SDK, and a dashboard. The <a href="/build" class="font-medium">build page</a> walks the whole path.</p>
              <div class="runcmd">
                <span class="prompt">$</span>
                <span class="cmd">{install}</span>
              </div>
            </div>
          </li>
          <li class="grid grid-cols-12 gap-4 items-baseline">
            <span class="col-span-12 md:col-span-2 label text-stone">Research</span>
            <span class="col-span-12 md:col-span-10">
              <a href="/research" class="font-medium">Research record</a> ·
              <a href="https://doi.org/10.5281/zenodo.19647159" class="font-medium">paper</a> ·
              <a href="https://huggingface.co/hikewa" class="font-medium">datasets</a>
            </span>
          </li>
          <li class="grid grid-cols-12 gap-4 items-baseline">
            <span class="col-span-12 md:col-span-2 label text-stone">Architecture</span>
            <span class="col-span-12 md:col-span-10"><a href="/ecosystem" class="font-medium">See the system map and companion projects.</a></span>
          </li>
          <li class="grid grid-cols-12 gap-4 items-baseline">
            <span class="col-span-12 md:col-span-2 label text-stone">Contact</span>
            <span class="col-span-12 md:col-span-10"><a href="mailto:founder@cirwel.org" class="font-mono text-base">founder@cirwel.org</a></span>
          </li>
        </ul>
      </div>
    </section>

    <div class="flex justify-center pt-10 pb-2">
      <Tailpiece class="opacity-90" />
    </div>

  </main>

  <PageFooter publishersMark />
</BaseLayout>

<style is:global>
  .figure-svg > svg { display: block; width: 100%; height: auto; }
</style>
