---
interface Props { currentPath: string; }
import markSvg from '../../public/mark-c-illuminated.svg?raw';

const { currentPath } = Astro.props;
const isEcosystem = currentPath === '/ecosystem';
const isResearch = currentPath === '/research';
const isBuild = currentPath === '/build';
---
<header class="px-6 lg:px-12 py-6 max-w-screen-xl mx-auto flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
  <a href="/" class="no-underline shrink-0 flex items-center gap-2.5">
    <span class="mark-device block w-[30px] h-[30px] sm:w-[36px] sm:h-[36px]" aria-hidden="true"><Fragment set:html={markSvg} /></span>
    <span class="display smcp text-lg sm:text-xl font-medium">CIRWEL Systems</span>
  </a>
  <nav aria-label="Primary" class="flex flex-wrap items-center justify-center sm:justify-end gap-x-5 gap-y-3 md:gap-7 label text-stone">
    <a href="/ecosystem" class:list={["no-underline transition-colors", isEcosystem ? "text-oxblood" : "hover:text-oxblood"]}>System</a>
    <a href="/research" class:list={["no-underline transition-colors", isResearch ? "text-oxblood" : "hover:text-oxblood"]}>Research</a>
    <a href="/build" class:list={["no-underline transition-colors", isBuild ? "text-oxblood" : "hover:text-oxblood"]}>Build</a>
    <a href="https://github.com/cirwel/unitares" class="no-underline hover:text-oxblood transition-colors">GitHub</a>
    <span class="impression-sep" aria-hidden="true"></span>
    <button id="impression" type="button" aria-label="Impression: automatic" class="impression no-underline hover:text-oxblood transition-colors">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
        <circle cx="8" cy="8" r="6.6" fill="none" stroke="currentColor" stroke-width="1"/>
        <path d="M 8 1.4 A 6.6 6.6 0 0 1 8 14.6 Z" fill="currentColor"/>
      </svg>
      <span data-impression-state>AUTO</span>
    </button>
  </nav>
</header>

<style is:global>
  .mark-device > svg { display: block; width: 100%; height: 100%; }
  .impression { display: none; align-items: center; gap: 0.42em; cursor: pointer; background: none; border: 0; padding: 0; color: inherit; font: inherit; letter-spacing: inherit; line-height: 1; }
  .js .impression { display: inline-flex; }
  .impression [data-impression-state] { font-variant-numeric: tabular-nums; min-width: 3.1em; text-align: left; }
  .impression:focus-visible { outline: 2px solid rgb(var(--c-oxblood)); outline-offset: 3px; border-radius: 1px; }
  .impression-sep { display: none; width: 1px; height: 0.9em; background: rgb(var(--c-sepia)); }
  .js .impression-sep { display: inline-block; }
  @media print { .impression, .impression-sep { display: none !important; } }
</style>
