---
/**
 * Schema.org JSON-LD for the CIRWEL Systems site.
 *
 * One @graph holds the brand's stable entities (Organization, Person,
 * ScholarlyArticle, SoftwareSourceCode); a per-page WebPage is appended
 * with the URL/title/description of whatever page rendered this component.
 *
 * Consumers: search engines (Google, Bing), academic indexers (Semantic
 * Scholar, OpenAlex via DOI cross-link), and AI search/citation crawlers
 * (ChatGPT, Claude, Perplexity) that increasingly route citations via JSON-LD.
 */
interface Props {
  pageUrl: string;
  pageTitle: string;
  pageDesc: string;
}
import papers from '../data/papers';
const { pageUrl, pageTitle, pageDesc } = Astro.props;

const scholarlyArticles = papers.map((p) => ({
  '@type': 'ScholarlyArticle',
  '@id': p.doi ? `https://doi.org/${p.doi}` : `https://cirwel.org/papers/${p.slug}/`,
  'name': p.title,
  'headline': p.title,
  'author': p.creators.length === 1 && p.orcid && p.orcid === p.creators[0].orcid
    ? { '@id': `https://orcid.org/${p.orcid}` }
    : p.creators.map((creator) => ({
        '@type': creator.type,
        'name': creator.name,
        ...(creator.orcid && { '@id': `https://orcid.org/${creator.orcid}` }),
      })),
  'datePublished': p.publicationDate,
  ...(p.doi
    ? {
        'identifier': [
          { '@type': 'PropertyValue', 'propertyID': 'doi', 'value': p.doi },
        ],
        'sameAs': `https://doi.org/${p.doi}`,
      }
    : {}),
  'publisher': p.publisher === undefined
    ? { '@id': 'https://cirwel.org/#org' }
    : (p.publisher ? { 'name': p.publisher } : undefined),
  'license': p.license ?? p.rights.map((right) => right.url || right.label),
  'url': `https://cirwel.org/papers/${p.slug}/`,
  'encoding': {
    '@type': 'MediaObject',
    'contentUrl': `https://cirwel.org/papers/${p.slug}/${p.pdfFile}`,
    'encodingFormat': 'application/pdf',
  },
  'keywords': p.keywords,
}));

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://cirwel.org/#website',
      'url': 'https://cirwel.org/',
      'name': 'CIRWEL Research',
      'description': 'Accountability infrastructure for long-running AI agents.',
      'publisher': { '@id': 'https://cirwel.org/#org' },
      'inLanguage': 'en',
    },
    {
      '@type': 'Organization',
      '@id': 'https://cirwel.org/#org',
      'name': 'CIRWEL Systems',
      'url': 'https://cirwel.org/',
      'foundingDate': '2025',
      'founder': { '@id': 'https://orcid.org/0009-0006-7544-2374' },
      'sameAs': [
        'https://github.com/cirwel',
      ],
    },
    {
      '@type': 'Person',
      '@id': 'https://orcid.org/0009-0006-7544-2374',
      'name': 'Kenny Wang',
      'givenName': 'Kenny',
      'familyName': 'Wang',
      'identifier': '0009-0006-7544-2374',
      'sameAs': [
        'https://orcid.org/0009-0006-7544-2374',
      ],
      'affiliation': { '@id': 'https://cirwel.org/#org' },
      'jobTitle': 'Independent Researcher',
    },
    ...scholarlyArticles,
    {
      '@type': 'SoftwareSourceCode',
      '@id': 'https://github.com/cirwel/unitares',
      'name': 'UNITARES',
      'description': 'Self-hosted accountability infrastructure for operators running multiple AI agents: identity, claims and evidence, review, outcomes, and reconstruction across agent runtimes.',
      'codeRepository': 'https://github.com/cirwel/unitares',
      'programmingLanguage': 'Python',
      'license': 'https://www.apache.org/licenses/LICENSE-2.0',
      'author': { '@id': 'https://orcid.org/0009-0006-7544-2374' },
      'isBasedOn': { '@id': 'https://doi.org/10.5281/zenodo.19647159' },
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': 'https://github.com/cirwel/unitares-governance-plugin',
      'name': 'UNITARES governance plugin',
      'description': 'Claude Code and Codex plugin that connects a session lifecycle to a UNITARES server.',
      'codeRepository': 'https://github.com/cirwel/unitares-governance-plugin',
      'license': 'https://www.apache.org/licenses/LICENSE-2.0',
      'author': { '@id': 'https://orcid.org/0009-0006-7544-2374' },
    },
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      'url': pageUrl,
      'name': pageTitle,
      'description': pageDesc,
      'isPartOf': { '@id': 'https://cirwel.org/#website' },
      'about': { '@id': 'https://doi.org/10.5281/zenodo.19647159' },
      'inLanguage': 'en',
    },
  ],
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(graph).replace(/</g, '\\u003c')}></script>
